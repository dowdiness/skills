{
  "name": "@dowdiness/skills",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "keywords": ["pi-package"],
  "scripts": {
    "install-local": "nu scripts/install.nu",
    "install-pi-package": "node scripts/install-pi-package.mjs",
    "list": "node scripts/list.mjs",
    "sync-extensions-status": "node scripts/sync-vendor-extensions.mjs --dry-run",
    "sync-status": "node scripts/sync-vendor-skills.mjs --dry-run",
    "sync-vendor": "node scripts/sync-vendor-skills.mjs",
    "sync-vendor-extensions": "node scripts/sync-vendor-extensions.mjs",
    "uninstall-local": "nu scripts/uninstall.nu",
    "check-agent-env": "node scripts/check-agent-env.mjs",
    "test": "bun test extensions/scheduler/*.test.ts extensions/scheduler/*.test.mjs scripts/install-pi-package.test.mjs scripts/validate-agent-models.test.mjs scripts/check-agent-env.test.mjs scripts/agent-prompt-contracts.test.mjs scripts/agent-usage-report.test.mjs",
    "validate": "node scripts/validate.mjs",
    "validate-agent-models": "node scripts/validate-agent-models.mjs",
    "validate-agent-prompts": "node scripts/agent-prompt-contracts.mjs",
    "agent-usage-report": "node scripts/agent-usage-report.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"]
  }
}
